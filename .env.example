NODE_ENV=development
PORT=3001
MONGO_URL=mongodb://127.0.0.1:27017/bigstar?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:3000

# Configure this to the known reverse-proxy hop count or subnet when deployed
# behind a proxy so rate limiting sees the real client IP.
TRUST_PROXY=false

# Required only by `npm run maintenance:create-admin`.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-unique-password
# ADMIN_NAME=Operations Administrator
# ADMIN_ROLE=ELT

# Optional alternatives to `--file` for the archived workbook migrations.
# IMPORT_WORKBOOK_PATH=<absolute-path-to-client-export.xlsm>
# SOURCE_WORKBOOK_PATH=<absolute-path-to-source-report.xlsm>
